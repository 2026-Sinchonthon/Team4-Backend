# 환경변수 예시 파일 (실제 값 X, 이 파일만 커밋)
# 로컬: 아래 값 그대로 docker-compose 의 MySQL 과 매칭됨
# 실제 값은 .env 로 복사해서 사용 (.env 는 git 에 커밋되지 않음)

# 활성 프로파일: local | prod
SPRING_PROFILES_ACTIVE=local

# --- 로컬(local) 프로파일 ---
# docker-compose 의 MYSQL_USER / MYSQL_PASSWORD 와 동일
DB_USERNAME=sinchonthon
DB_PASSWORD=sinchonthon

# 32바이트 이상의 무작위 키를 Base64로 인코딩한 값
JWT_SECRET=<BASE64_ENCODED_SECRET>
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600

# --- 배포(prod) 프로파일에서만 사용 ---
# EC2 의 /etc/sinchonthon/app.env 에 설정
# DB_URL=jdbc:mysql://daybit-db.c7caskqkw2ty.ap-northeast-2.rds.amazonaws.com:3306/sinchonthon?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# DB_USERNAME=sinchonthon_app
# DB_PASSWORD=<RDS 애플리케이션 계정 비밀번호>
